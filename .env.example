# Copy to .env, then set arm adapter paths and gripper measurements.
# Setup: tutorial/01-first-recording.md
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-makermods

# Robot and teleop hosts: gripper calibration, required, measured per arm (the
# gripper motor's angle with the jaws fully closed / fully open; dreamcli setup
# or by hand). Use METAL_{LEFT,RIGHT}_GRIPPER_*_DEG if the two arms differ.
# METAL_GRIPPER_CLOSED_DEG=0
# METAL_GRIPPER_OPEN_DEG=90
# METAL_GRIPPER_HOLD_NM=0.5    # the gripper's holding torque on an object, N.m

# Direct USB serial CAN (SLCAN): uncomment the two entries for this host and
# replace the example IDs with distinct paths from /dev/serial/by-id/.
# Dream opens these at 1 Mbps; no slcand or ip-link setup is needed.
# METAL_FOLLOWER_RIGHT_CAN=/dev/serial/by-id/RIGHT_ADAPTER_ID
# METAL_FOLLOWER_LEFT_CAN=/dev/serial/by-id/LEFT_ADAPTER_ID
# METAL_LEADER_RIGHT_CAN=/dev/serial/by-id/RIGHT_ADAPTER_ID
# METAL_LEADER_LEFT_CAN=/dev/serial/by-id/LEFT_ADAPTER_ID
# Existing SocketCAN setups can use canN instead; see tutorial/09-reference.md.

# Robot cameras (Linux /dev/videoN, macOS an index such as 0). Left and right are as the robot sees them.
# METAL_CAM_OVERHEAD=/dev/video0
# METAL_CAM_LEFT_WRIST=/dev/video2
# METAL_CAM_RIGHT_WRIST=/dev/video4

# Dream-1 host. The API key lives in ~/.dreamlabs/credentials, not here.
# DREAM_CHECKPOINT=dreamlabs/dream-1-beta
