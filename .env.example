# Copy to .env and fill in; tutorial/01-first-recording.md walks through each value.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-makermods

# Robot host: one CAN adapter per Metal follower, a /dev/serial/by-id/... path
# (SLCAN), or a SocketCAN link that is up at 1 Mbps (candleLight: can0, can1).
# METAL_FOLLOWER_LEFT_CAN=can1
# METAL_FOLLOWER_RIGHT_CAN=can0

# Teleop host: the USB serial port of each Star Arm 102 leader.
# STAR_LEADER_LEFT_PORT=/dev/serial/by-id/LEFT_LEADER_ID
# STAR_LEADER_RIGHT_PORT=/dev/serial/by-id/RIGHT_LEADER_ID
# The leader gripper servo's turn from closed to open: 41.2 for the vertical
# grip (default), about 60.7 for the stock lever.
# STAR_GRIPPER_TRAVEL_DEG=41.2

# Follower gripper motor angle with the jaws fully closed / open, measured per arm.
# Shared, or per side as METAL_{LEFT,RIGHT}_GRIPPER_*_DEG.
# METAL_GRIPPER_CLOSED_DEG=0
# METAL_LEFT_GRIPPER_OPEN_DEG=115
# METAL_RIGHT_GRIPPER_OPEN_DEG=114

# Robot cameras (Linux /dev/videoN, macOS an index such as 0), as the robot sees them.
# METAL_CAM_OVERHEAD=/dev/video2
# METAL_CAM_LEFT_WRIST=/dev/video4
# METAL_CAM_RIGHT_WRIST=/dev/video6

# Dream-1 (platform.dreamlabs.ai, API Keys).
# DREAM_API_KEY=dl_live_...
