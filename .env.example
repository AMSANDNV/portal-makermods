# Copy to .env and fill in; tutorial/01-first-recording.md walks through each value.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-makermods

# One CAN adapter per arm: a /dev/serial/by-id/... path (SLCAN), or a SocketCAN
# link that is up at 1 Mbps (candleLight: can0, can1). Robot host:
# METAL_FOLLOWER_LEFT_CAN=can1
# METAL_FOLLOWER_RIGHT_CAN=can0
# Teleop host:
# METAL_LEADER_LEFT_CAN=/dev/serial/by-id/LEFT_ADAPTER_ID
# METAL_LEADER_RIGHT_CAN=/dev/serial/by-id/RIGHT_ADAPTER_ID

# Gripper motor angle with the jaws fully closed / open, measured per arm.
# Shared, or per side as METAL_{LEFT,RIGHT}_GRIPPER_*_DEG.
# METAL_GRIPPER_CLOSED_DEG=0
# METAL_LEFT_GRIPPER_OPEN_DEG=115
# METAL_RIGHT_GRIPPER_OPEN_DEG=114

# Robot cameras (Linux /dev/videoN, macOS an index such as 0), as the robot sees them.
# METAL_CAM_OVERHEAD=/dev/video2
# METAL_CAM_LEFT_WRIST=/dev/video4
# METAL_CAM_RIGHT_WRIST=/dev/video6

# Dream-1 (platform.dreamlabs.ai, API Keys).
# DREAM_API_KEY=dl_live_...

# Voice agent (tutorial/10-voice-tasks.md): its speech and LLM run on LiveKit Inference, which needs a LiveKit
# Cloud project. With a self-hosted LIVEKIT_URL, give a Cloud project's key here:
# LIVEKIT_INFERENCE_API_KEY=
# LIVEKIT_INFERENCE_API_SECRET=
