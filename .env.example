# Copy to .env. Everything else has a default: tutorial/09-reference.md#configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-makermods

# Robot and teleop hosts: the vendor SDK's arm model. Defaults to a clone of
# metal-python-ros in your home directory.
# METAL_URDF=~/metal-python-ros/metal_sdk/example/urdf/metal_with_gripper.urdf

# CAN links, the vendor's two-pair layout by default (metal_ros2/can_scripts).
# METAL_FOLLOWER_RIGHT_CAN=can1
# METAL_FOLLOWER_LEFT_CAN=can3
# METAL_LEADER_RIGHT_CAN=can0
# METAL_LEADER_LEFT_CAN=can2

# Robot cameras (Linux /dev/videoN, macOS an index such as 0). Left and right are as the robot sees them.
# METAL_CAM_OVERHEAD=/dev/video0
# METAL_CAM_LEFT_WRIST=/dev/video2
# METAL_CAM_RIGHT_WRIST=/dev/video4

# Dream-1 host. The API key lives in ~/.dreamlabs/credentials, not here.
# DREAM_CHECKPOINT=dreamlabs/dream-1-beta
